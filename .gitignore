# ============================================================
# GhostNet — Root .gitignore
# ============================================================

# ---- Python ------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
*.pyo
*.pyd
.Python
pip-log.txt
pip-delete-this-directory.txt
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.log
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/

# ---- Virtual environments ----------------------------------
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
.conda/

# ---- Node / Next.js ----------------------------------------
node_modules/
.next/
out/
.vercel/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- Environment variables (NEVER commit real secrets) -----
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.production
# Keep examples committed:
!.env.example
!.env.local.example

# ---- Model weights -----------------------------------------
# Use Git LFS or a download script instead of committing raw weights
*.onnx
*.pt
*.pth
*.h5
*.pb
*.tflite
*.bin
# Keep the gitkeep placeholder:
!model_weights/.gitkeep

# ---- ML data -----------------------------------------------
ml/data/*
!ml/data/.gitkeep

# ---- IDE / editors -----------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ---- Jupyter -----------------------------------------------
.ipynb_checkpoints/

# ---- Testing / coverage ------------------------------------
htmlcov/
.pytest_cache/
*.coveragerc

# ---- Misc --------------------------------------------------
*.tmp
*.bak
*.orig
